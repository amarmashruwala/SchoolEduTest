# Environment configuration — copy to .env.local for local development.
# Never commit real secrets. Never prefix privileged secrets with NEXT_PUBLIC_.

APP_URL=http://localhost:3000

# Provider & Safety Gates (fail-closed defaults)
MOCK_AI=true
CHILD_AI_ENABLED=false
PROVIDER_ELIGIBILITY_APPROVED=false

# Gemini Developer API (server-side only; unused while MOCK_AI=true)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=

# Supabase (Phase 3+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
